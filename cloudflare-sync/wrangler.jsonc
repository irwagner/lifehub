{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifehub-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Serve o app mobile PWA (iPhone + Android) no mesmo endereço gratuito *.workers.dev
  "assets": {
    "directory": "../dist-mobile",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Durable Object com SQLite gratuito (Cloudflare Free Tier: 100k req/dia, 5 GB, consistência forte)
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT_DO",
        "class_name": "VaultDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultDurableObject"]
    }
  ]
}
