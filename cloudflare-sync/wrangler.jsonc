{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifehub-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Serve o app mobile PWA (iPhone + Android) no mesmo domínio gratuito *.workers.dev
  "assets": {
    "directory": "../dist-mobile",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Plano Free Cloudflare KV: 100k leituras/dia, 1k escritas/dia, 1 GB grátis.
  // Rode: npx wrangler kv namespace create LIFEHUB_VAULTS e cole o id gerado abaixo.
  "kv_namespaces": [
    {
      "binding": "LIFEHUB_VAULTS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
